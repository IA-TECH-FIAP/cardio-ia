[
    {
        "id": "cardioia-tab",
        "type": "tab",
        "label": "CardioIA - Monitoramento",
        "disabled": false,
        "info": "Dashboard de monitoramento cardiaco em tempo real.\n\nAssina os topicos cardioia/+/sinais e cardioia/+/alerta no broker publico HiveMQ e exibe BPM (chart), temperatura (gauge) e indicador de alerta clinico."
    },
    {
        "id": "hivemq-broker",
        "type": "mqtt-broker",
        "name": "HiveMQ Publico",
        "broker": "broker.hivemq.com",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": ""
    },
    {
        "id": "cardioia-ui-base",
        "type": "ui_base",
        "theme": {
            "name": "theme-light",
            "lightTheme": {
                "default": "#0094CE",
                "baseColor": "#0094CE",
                "baseFont": "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen-Sans,Ubuntu,Cantarell,Helvetica Neue,sans-serif",
                "edited": true,
                "reset": false
            }
        },
        "site": {
            "name": "CardioIA",
            "hideToolbar": "false",
            "allowSwipe": "false",
            "lockMenu": "false",
            "allowTempTheme": "true",
            "dateFormat": "DD/MM/YYYY",
            "sizes": { "sx": 48, "sy": 48, "gx": 6, "gy": 6, "cx": 6, "cy": 6, "px": 0, "py": 0 }
        }
    },
    {
        "id": "tab-monitor",
        "type": "ui_tab",
        "name": "Monitoramento",
        "icon": "favorite",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "group-sinais",
        "type": "ui_group",
        "name": "Sinais Vitais",
        "tab": "tab-monitor",
        "order": 1,
        "disp": true,
        "width": "8",
        "collapse": false
    },
    {
        "id": "group-alerta",
        "type": "ui_group",
        "name": "Status Clinico",
        "tab": "tab-monitor",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "mqtt-in-sinais",
        "type": "mqtt in",
        "z": "cardioia-tab",
        "name": "MQTT cardioia/+/sinais",
        "topic": "cardioia/+/sinais",
        "qos": "1",
        "datatype": "json",
        "broker": "hivemq-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 120,
        "wires": [["fn-extrai-campos"]]
    },
    {
        "id": "fn-extrai-campos",
        "type": "function",
        "z": "cardioia-tab",
        "name": "Extrai bpm/temp/alerta",
        "func": "// Recebe payload JSON do ESP32 e gera 3 mensagens em saidas distintas:\n//   1) chart de BPM\n//   2) gauge de temperatura\n//   3) avaliacao de alerta clinico (texto colorido)\nconst p = msg.payload || {};\nconst bpm   = Number(p.bpm);\nconst temp  = Number(p.temp);\nconst umid  = Number(p.umid);\nconst alert = Boolean(p.alert);\n\nconst LIM_BPM_MAX  = 120;\nconst LIM_BPM_MIN  = 50;\nconst LIM_TEMP_MAX = 38.0;\nconst LIM_TEMP_MIN = 35.0;\n\nlet estado = 'NORMAL';\nlet cor    = '#2ECC71';\nlet motivo = '';\n\nif (bpm > LIM_BPM_MAX)        { estado = 'ALERTA'; cor = '#E74C3C'; motivo = 'Taquicardia (BPM > 120)'; }\nelse if (bpm < LIM_BPM_MIN)   { estado = 'ALERTA'; cor = '#E74C3C'; motivo = 'Bradicardia (BPM < 50)'; }\nelse if (temp > LIM_TEMP_MAX) { estado = 'ALERTA'; cor = '#E74C3C'; motivo = 'Febre (T > 38C)'; }\nelse if (temp < LIM_TEMP_MIN) { estado = 'ALERTA'; cor = '#3498DB'; motivo = 'Hipotermia (T < 35C)'; }\n\nconst html = `<div style=\"text-align:center;padding:18px;background:${cor};color:white;border-radius:8px;font-size:24px;font-weight:bold\">STATUS: ${estado}<div style=\"font-size:14px;margin-top:6px;font-weight:normal\">${motivo || 'Sinais dentro dos limites cl\\u00ednicos'}</div><div style=\"font-size:12px;margin-top:8px;font-weight:normal\">BPM=${bpm}  Temp=${temp.toFixed(1)}\\u00b0C  Umid=${umid.toFixed(0)}%</div></div>`;\n\nreturn [\n  { payload: bpm,  topic: 'BPM'  },\n  { payload: temp, topic: 'Temperatura' },\n  { payload: html, estado, motivo }\n];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 120,
        "wires": [["ui-chart-bpm"], ["ui-gauge-temp"], ["ui-text-alerta"]]
    },
    {
        "id": "ui-chart-bpm",
        "type": "ui_chart",
        "z": "cardioia-tab",
        "name": "BPM",
        "group": "group-sinais",
        "order": 1,
        "width": 8,
        "height": 4,
        "label": "Batimentos cardiacos (BPM)",
        "chartType": "line",
        "legend": "false",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "Aguardando ESP32...",
        "dot": false,
        "ymin": "30",
        "ymax": "190",
        "removeOlder": "5",
        "removeOlderPoints": "",
        "removeOlderUnit": "60",
        "cutout": 0,
        "useOneColor": false,
        "useUTC": false,
        "colors": ["#E74C3C", "#aec7e8", "#ff7f0e", "#2ca02c", "#98df8a", "#d62728", "#ff9896", "#9467bd", "#c5b0d5"],
        "outputs": 1,
        "useDifferentColor": false,
        "x": 700,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "ui-gauge-temp",
        "type": "ui_gauge",
        "z": "cardioia-tab",
        "name": "Temperatura",
        "group": "group-sinais",
        "order": 2,
        "width": 8,
        "height": 3,
        "gtype": "gage",
        "title": "Temperatura corporal (°C)",
        "label": "°C",
        "format": "{{value | number:1}}",
        "min": "30",
        "max": "42",
        "colors": ["#3498DB", "#2ECC71", "#E74C3C"],
        "seg1": "37.5",
        "seg2": "38",
        "x": 710,
        "y": 130,
        "wires": []
    },
    {
        "id": "ui-text-alerta",
        "type": "ui_template",
        "z": "cardioia-tab",
        "group": "group-alerta",
        "name": "Indicador de alerta",
        "order": 1,
        "width": "6",
        "height": "4",
        "format": "<div ng-bind-html=\"msg.payload\"></div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 720,
        "y": 180,
        "wires": [[]]
    },
    {
        "id": "mqtt-in-alerta",
        "type": "mqtt in",
        "z": "cardioia-tab",
        "name": "MQTT cardioia/+/alerta",
        "topic": "cardioia/+/alerta",
        "qos": "1",
        "datatype": "json",
        "broker": "hivemq-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 280,
        "wires": [["fn-log-alerta"]]
    },
    {
        "id": "fn-log-alerta",
        "type": "function",
        "z": "cardioia-tab",
        "name": "Log alerta clinico",
        "func": "// Apenas faz log no debug; o indicador visual ja e tratado pela funcao principal\nnode.warn(`Alerta clinico recebido: ${JSON.stringify(msg.payload)}`);\nreturn null;",
        "outputs": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 280,
        "wires": []
    }
]
